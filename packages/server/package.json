{
  "name": "@pure-galaxy/server",
  "version": "0.1.0",
  "description": "Authoritative multiplayer server for PURE GALAXY: WebSocket state streaming + REST, deterministic world tick, pluggable persistence (design prompt §18.2, §18.4).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "tsx bin/serve.ts",
    "smoke": "tsx bin/smoke.ts"
  },
  "dependencies": {
    "@pure-galaxy/shared": "workspace:*",
    "@pure-galaxy/world-core": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
