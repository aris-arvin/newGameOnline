{
  "name": "@pure-galaxy/combat-core",
  "version": "0.1.0",
  "description": "Deterministic WEGO tactical combat engine for PURE GALAXY (design prompt §10, §21.2).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "autobattle": "tsx bin/autobattle.ts",
    "meta": "tsx bin/meta.ts"
  },
  "dependencies": {
    "@pure-galaxy/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
